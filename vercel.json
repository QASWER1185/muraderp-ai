{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix frontend --include=dev --prefer-offline --no-audit --no-fund --maxsockets=4 --fetch-retries=5",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/copilot",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/v1/ai/copilot/v2/chat"
    },
    {
      "source": "/api/copilot/chat",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/v1/ai/copilot/v2/chat"
    },
    {
      "source": "/api/copilot/agent",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/v1/ai/copilot/v2/chat"
    },
    {
      "source": "/api/copilot/agent/input",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/v1/ai/copilot/v2/chat"
    },
    {
      "source": "/api/v1/ai/copilot",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/v1/ai/copilot/v2/chat"
    },
    {
      "source": "/api/v1/ai/copilot/chat",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/v1/ai/copilot/v2/chat"
    },
    {
      "source": "/api/v1/ai/copilot/agent",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/v1/ai/copilot/v2/chat"
    },
    {
      "source": "/api/v1/ai/copilot/agent/input",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/v1/ai/copilot/v2/chat"
    },
    {
      "source": "/api/copilot/:path*",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/copilot/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://muraderp-api-jy6eophhla-el.a.run.app/api/v1/:path*"
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "value": "no-cache, max-age=0, must-revalidate",
          "key": "Cache-Control"
        }
      ],
      "source": "/"
    },
    {
      "headers": [
        {
          "value": "no-cache, max-age=0, must-revalidate",
          "key": "Cache-Control"
        }
      ],
      "source": "/index.html"
    },
    {
      "headers": [
        {
          "value": "no-cache, max-age=0, must-revalidate",
          "key": "Cache-Control"
        }
      ],
      "source": "/sw.js"
    },
    {
      "headers": [
        {
          "value": "no-cache, max-age=0, must-revalidate",
          "key": "Cache-Control"
        }
      ],
      "source": "/copilot-ui.js"
    },
    {
      "headers": [
        {
          "value": "no-cache, max-age=0, must-revalidate",
          "key": "Cache-Control"
        }
      ],
      "source": "/styles.css"
    },
    {
      "source": "/copilot-api.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/public-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "copilot-v2": false
    }
  }
}
