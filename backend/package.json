{
  "name": "@muraderp/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable ERP for building-material businesses",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
