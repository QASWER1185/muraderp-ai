NODE_ENV=development
PORT=3000

# Server-only AI provider for Copilot text/review and optional media input.
# Choose groq or openai. For another Responses API-compatible provider, use compatible
# with an HTTPS AI_BASE_URL and its AI_MODEL. Keep keys in server secrets, never browser code.
AI_PROVIDER=groq
AI_API_KEY=replace_me_with_server_only_provider_key
# AI_BASE_URL=https://your-compatible-provider.example/v1
# AI_MODEL=openai/gpt-oss-120b
# AI_VISION_MODEL=qwen/qwen3.8-27b
# AI_SPEECH_MODEL=whisper-large-v3-turbo
# GROQ_API_KEY and OPENAI_API_KEY remain supported as provider-specific alternatives.

# Server-only database principal. Never expose this value in browser code.
# Create a named sb_secret_ key in Supabase Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-to-server HTTP credential. Rotate independently of the audit identity.
INTERNAL_API_TOKEN=replace_with_a_long_random_internal_token

# Required stable audit identity for the service holding INTERNAL_API_TOKEN.
# This is not a credential and must not be a generic/default identity.
INTERNAL_API_PRINCIPAL_ID=replace_with_unique_service_principal_id
