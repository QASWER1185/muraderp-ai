NODE_ENV=development
PORT=3000

# Server-only database principal. Never expose this value in browser code.
# Create a named sb_secret_ key in Supabase Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-to-server HTTP credential. Rotate independently of the audit identity.
INTERNAL_API_TOKEN=replace_with_a_long_random_internal_token

# Required stable audit identity for the service holding INTERNAL_API_TOKEN.
# This is not a credential and must not be a generic/default identity.
INTERNAL_API_PRINCIPAL_ID=replace_with_unique_service_principal_id
