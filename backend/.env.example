NODE_ENV=development
PORT=3000

# Public application configuration. Safe to expose to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only MuradERP-AI access. Never expose either value in browser code.
# Create a named sb_secret_ key in Supabase Settings > API Keys.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Use a cryptographically random value of at least 32 characters.
INTERNAL_API_TOKEN=replace_with_a_long_random_internal_token

# Stable identity used to scope idempotency keys for the current internal principal.
# Do not use the bearer token itself as this value.
INTERNAL_API_PRINCIPAL_ID=internal-system
