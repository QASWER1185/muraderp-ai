FROM node:22-alpine AS reversal-build
WORKDIR /build
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --prefix backend --no-audit --no-fund
COPY backend ./backend
RUN npm run build --prefix backend

# Exact working reporting runtime; preserve production-only estimate and Copilot routes.
FROM asia-south1-docker.pkg.dev/muraderp-ai/cloud-run-source-deploy/muraderp-api@sha256:af54e7686df118ca37ea294757b0df661a122ed556695c114c938f391bfbdd8d
COPY --from=reversal-build /build/backend/dist/services/accounting/reversal.service.js /app/backend/dist/services/accounting/reversal.service.js
COPY --from=reversal-build /build/backend/dist/routes/record-deletion.routes.js /app/backend/dist/routes/record-deletion.routes.js
COPY --from=reversal-build /build/backend/dist/routes/capabilities.routes.js /app/backend/dist/routes/capabilities.routes.js
COPY frontend /app/frontend
