FROM node:22-alpine AS build
WORKDIR /build
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --prefix backend --no-audit --no-fund
COPY backend ./backend
RUN npm run build --prefix backend && npm prune --prefix backend --omit=dev --ignore-scripts

# Keep production-only controllers from the currently serving revision.
FROM asia-south1-docker.pkg.dev/muraderp-ai/cloud-run-source-deploy/muraderp-api@sha256:a64f692769aedbe2812727fa8748f7099776a2e3d34d58530e3e05534224fa76
COPY --from=build /build/backend/node_modules/body-parser /app/backend/node_modules/body-parser
COPY --from=build /build/backend/node_modules/qs /app/backend/node_modules/qs
COPY --from=build /build/backend/node_modules/zod /app/backend/node_modules/zod
COPY --from=build /build/backend/dist/routes/accounting.browser.routes.js /app/backend/dist/routes/accounting.browser.routes.js
COPY --from=build /build/backend/dist/reports/supabase-reporting.gateway.js /app/backend/dist/reports/supabase-reporting.gateway.js
COPY --from=build /build/backend/dist/ai-copilot/conversationalMunshi.js /app/backend/dist/ai-copilot/conversationalMunshi.js
COPY --from=build /build/backend/dist/ai-copilot/siteTransferService.js /app/backend/dist/ai-copilot/siteTransferService.js
COPY scripts/patch-expenses-runtime.mjs /tmp/patch-expenses-runtime.mjs
RUN node /tmp/patch-expenses-runtime.mjs && cd /app/backend && NODE_ENV=test node --input-type=module -e "await import('./dist/app.js')"
COPY frontend /app/frontend
